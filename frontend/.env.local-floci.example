# === Backend target: LOCAL services + Floci (dev auth, no Cognito) ===
# Usage: cp .env.local-floci .env.local   (then `npm run dev`)
# Requires: make floci-up + both uvicorn services on :8080/:8081.
VITE_API_BASE_URL=http://127.0.0.1:8080
VITE_WRITE_BASE_URL=http://127.0.0.1:8081
VITE_DEV_USER_ID=dev-user-local
VITE_FEATURE_SEARCH=false
VITE_FEATURE_IMAGES=true
# Cognito unused in dev mode (VITE_DEV_USER_ID set)
VITE_COGNITO_REGION=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=
VITE_REDIRECT_URI=
