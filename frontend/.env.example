# Plug in these values and the app runs. Copy to .env.local.
VITE_API_BASE_URL=http://localhost:8080
VITE_COGNITO_REGION=eu-central-1
VITE_COGNITO_USER_POOL_ID=eu-central-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_DOMAIN=https://threadit.auth.eu-central-1.amazoncognito.com
VITE_REDIRECT_URI=http://localhost:5173/auth/callback
# optional feature flags (default true)
VITE_FEATURE_SEARCH=true
VITE_FEATURE_IMAGES=true
