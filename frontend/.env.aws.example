# === Backend target: REAL AWS (ALB API + real Cognito) ===
# Usage: cp .env.aws .env.local   (then `npm run dev`)
# Fill ALB DNS + Cognito values from `terraform output`.
VITE_API_BASE_URL=http://REPLACE_ALB_DNS
VITE_FEATURE_SEARCH=true
VITE_FEATURE_IMAGES=true
VITE_COGNITO_REGION=eu-central-1
VITE_COGNITO_USER_POOL_ID=REPLACE_POOL_ID
VITE_COGNITO_CLIENT_ID=REPLACE_CLIENT_ID
VITE_COGNITO_DOMAIN=https://REPLACE_COGNITO_DOMAIN
VITE_REDIRECT_URI=http://localhost:5173/auth/callback
